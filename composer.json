{
    "name": "adrien-chinour/blog",
    "description": "Blog udfn.fr",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-opentelemetry": "*",
        "league/commonmark": "^2.8",
        "meilisearch/meilisearch-php": "^1.10",
        "monolog/monolog": "^3.5",
        "nyholm/psr7": "^1.0",
        "open-telemetry/api": "^1",
        "open-telemetry/context": "^1",
        "open-telemetry/exporter-otlp": "^1.3",
        "open-telemetry/opentelemetry-auto-symfony": "^1.1",
        "open-telemetry/sdk": "^1.10",
        "open-telemetry/sem-conv": "^1",
        "psr/log": "^3.0",
        "runtime/frankenphp-symfony": "^0.2.0",
        "sentry/sentry-symfony": "^5.8",
        "symfony/cache": "8.1.*",
        "symfony/cache-contracts": "^3",
        "symfony/config": "8.1.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/dotenv": "8.1.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-client-contracts": "^3",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/lock": "8.1.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-access": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-http": "7.4.*",
        "symfony/serializer": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webhook": "8.1.*",
        "symfony/yaml": "8.1.*",
        "tempest/highlight": "^2.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.8",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.31",
        "maglnet/composer-require-checker": "^4",
        "mockery/mockery": "^1.6",
        "phparkitect/phparkitect": "^0.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/web-profiler-bundle": "7.4.*",
        "symplify/easy-coding-standard": "^13.0",
        "symplify/phpstan-rules": "~14.9.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "infection/extension-installer": false
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Infrastructure/Component/OpenTelemetry/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "pre-command-run": [
            "@putenv OTEL_PHP_AUTOLOAD_ENABLED=false"
        ],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "quality": [
            "@composer validate --strict",
            "@quality:lint",
            "@quality:phpstan",
            "@quality:ecs",
            "@quality:arkitect",
            "@quality:rector",
            "@quality:deps"
        ],
        "quality:phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
        "quality:ecs": "vendor/bin/ecs check",
        "quality:arkitect": "vendor/bin/phparkitect check --config=tests/Architecture/arkitect.php",
        "quality:rector": "vendor/bin/rector process --dry-run",
        "quality:deps": [
            "vendor/bin/composer-require-checker check",
            "vendor/bin/composer-unused"
        ],
        "quality:lint": [
            "bin/console lint:yaml config --parse-tags",
            "bin/console lint:container"
        ],
        "test": [
            "bin/phpunit"
        ],
        "test-coverage": "bin/phpunit --testsuite=All --coverage-clover=var/coverage/clover.xml --coverage-cobertura=var/coverage/cobertura.xml --coverage-html=var/coverage/html",
        "test-mutation": "vendor/bin/infection --threads=max --show-mutations=0",
        "test-unit": [
            "bin/phpunit --testsuite Unit"
        ],
        "test-integration": [
            "bin/phpunit --testsuite Integration"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
